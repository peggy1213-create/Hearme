# Hearme environment — copy to .env and fill in. NEVER commit .env.
#
# Vendor API keys live ONLY on the gateway (services/gateway), never in the
# desktop app. See CLAUDE.md.

# --- Speech-to-text vendors (gateway only) ---
SONIOX_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# --- STT vendor selection (gateway) ---
# Provisional default until the Phase 0 benchmark decides ADR 0002; see ADR 0005.
STT_LIVE_VENDOR=soniox
STT_FALLBACK_VENDOR=assemblyai

# --- LLM for summaries and action items (gateway only) ---
ANTHROPIC_API_KEY=

# --- OAuth sign-in (gateway) ---
# OAuth 2 with PKCE. The desktop app opens the system browser and receives the
# code on a loopback redirect, then exchanges it through the gateway.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- Tokens (gateway) ---
# Secret used to sign JWT access + refresh tokens. Use a long random value in prod.
JWT_SECRET=dev-insecure-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Dev-only bypass token, honoured ONLY when NODE_ENV=development.
DEV_BYPASS_TOKEN=dev-bypass

# --- Quota (gateway) ---
# Monthly transcription minutes per user, enforced on session start.
MONTHLY_QUOTA_MINUTES=1200

# --- Accounts and usage database (gateway) ---
# Matches docker-compose.yml defaults for local development.
DATABASE_URL=postgresql://hearme:hearme@localhost:5432/hearme

# --- Observability (gateway, optional) ---
# When set, OpenTelemetry traces + metrics export here; unset = no-op (tests).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hearme-gateway

# --- Server ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
