# Normalise all text files to LF on checkout and commit.
* text=auto eol=lf

# Explicit text types (kept LF across platforms).
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.rs    text eol=lf
*.swift text eol=lf
*.toml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf

# Scripts that must keep their native line endings.
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never touch line endings.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
